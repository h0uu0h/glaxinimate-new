/* Glaxnimate — AirJelly Theme */

/* Global */
QMainWindow, QDialog {
    font-size: 13px;
}

* {
    outline: none;
}

/* Dock widgets — minimal title bars */
QDockWidget {
    font-size: 11px;
    font-weight: 500;
    color: palette(button-text);
}

QDockWidget::title {
    background: palette(window);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 5px 8px;
    text-align: left;
}

QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
    icon-size: 11px;
    subcontrol-position: top right;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
}

/* Tab bars — bottom-line indicator */
QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 5px 12px;
    font-size: 11px;
    color: palette(button-text);
    min-width: 36px;
}

QTabBar::tab:selected {
    border-bottom-color: palette(highlight);
    color: palette(text);
}

QTabBar::tab:hover:!selected {
    border-bottom-color: rgba(255, 255, 255, 0.12);
    color: palette(text);
}

QTabWidget::pane {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

/* Toolbars — seamless with window */
QToolBar {
    background: palette(window);
    border: none;
    spacing: 1px;
    padding: 2px;
}

QToolBar::separator {
    background: rgba(255, 255, 255, 0.06);
    width: 1px;
    margin: 4px 3px;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 3px;
    margin: 1px;
}

QToolButton:hover {
    background: rgba(255, 255, 255, 0.07);
}

QToolButton:pressed {
    background: rgba(255, 255, 255, 0.10);
}

QToolButton:checked {
    background: palette(highlight);
    color: palette(highlighted-text);
    border-radius: 5px;
}

/* Scrollbars — ultra thin */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.22);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.12);
    min-width: 30px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.22);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* Menu bar — ghost style */
QMenuBar {
    background: palette(window);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 1px 0;
    font-size: 13px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background: rgba(255, 255, 255, 0.07);
}

/* Menus — soft floating panels */
QMenu {
    background: palette(base);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 4px 0;
    font-size: 13px;
}

QMenu::item {
    padding: 6px 28px 6px 12px;
    border-radius: 5px;
    margin: 0 4px;
}

QMenu::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 4px 10px;
}

/* Inputs — subtle borders */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 12px;
    color: palette(text);
    selection-background-color: palette(highlight);
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid rgba(124, 108, 240, 0.6);
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: palette(base);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    selection-background-color: palette(highlight);
}

/* Sliders — minimal */
QSlider::groove:horizontal {
    border: none;
    height: 3px;
    background: rgba(255, 255, 255, 0.10);
    border-radius: 1.5px;
}

QSlider::handle:horizontal {
    background: palette(highlight);
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #8d80f4;
}

/* Group boxes */
QGroupBox {
    border: none;
    margin-top: 8px;
    padding-top: 4px;
    font-weight: 500;
    font-size: 12px;
}

QGroupBox::title {
    color: palette(button-text);
    subcontrol-origin: margin;
    left: 4px;
    padding: 0 4px;
}

/* Status bar */
QStatusBar {
    background: palette(window);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 11px;
    color: palette(button-text);
}

/* Push buttons — ghost by default */
QPushButton {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 5px;
    padding: 4px 14px;
    font-size: 12px;
    color: palette(text);
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
}

QPushButton:pressed {
    background: rgba(255, 255, 255, 0.12);
}

QPushButton:default {
    border: 1px solid rgba(124, 108, 240, 0.5);
}

/* Tree and list views — subtle rows */
QTreeView, QListView, QTableView {
    background: palette(base);
    border: none;
    alternate-background-color: rgba(255, 255, 255, 0.02);
    font-size: 12px;
}

QTreeView::item, QListView::item {
    padding: 2px 4px;
    border-radius: 3px;
}

QTreeView::item:selected, QListView::item:selected {
    background: rgba(124, 108, 240, 0.25);
    color: palette(text);
}

QTreeView::item:hover:!selected, QListView::item:hover:!selected {
    background: rgba(255, 255, 255, 0.04);
}

QTreeView::branch:has-children:closed {
    image: none;
}

QTreeView::branch:has-children:open {
    image: none;
}

QHeaderView {
    background: palette(window);
    border: none;
}

QHeaderView::section {
    background: palette(window);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 500;
    color: palette(button-text);
}

/* Splitter handles — hairline */
QSplitter::handle {
    background: rgba(255, 255, 255, 0.04);
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* Tooltips — floating chip */
QToolTip {
    background: palette(tooltip-base);
    color: palette(tooltip-text);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
}

/* Frame — remove sunken/raised look */
QFrame[frameShape="6"], QFrame[frameShape="5"] {
    border: none;
}
